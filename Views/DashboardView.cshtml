@* @page *@
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Identity
@using SuperCoolWebServer.Models
@using SuperCoolWebServer.Views
@* @model SuperCoolWebServer.Views.DashboardView *@

@{
    var antiforgery = ViewContext.HttpContext.RequestServices.GetRequiredService<IAntiforgery>();
    var tokens = antiforgery.GetAndStoreTokens(Context);
    var userMgr = Context.RequestServices.GetRequiredService<UserManager<SuperCoolUser>>();
    var user = (await userMgr.GetUserAsync(Context.User))!;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <title>Super Cool Dashboard :D</title>
    <meta name="darkreader-lock">

    <!--suppress JSUnresolvedLibraryURL -->
    <link href="https://unpkg.com/@@spiritov/ds.css" rel="stylesheet"/>
    <link href="/frontend/styles/main.css" rel="stylesheet"/>

    <link href="https://unpkg.com/uppy@5.2.4/dist/uppy.min.css" rel="stylesheet">
    <script src="https://unpkg.com/uppy@5.2.4/dist/uppy.min.js"></script>
    <script src="https://unpkg.com/jquery@4.0.0/dist/jquery.min.js"></script>
</head>

<body class="ds-grid">

<div class="info">
    <div class="info-square">
        <img
            src="data:image/png;base64,"
            alt="An outline of a gear"/>
    </div>
    <div class="info-container">
        <div class="info-label">Your Permissions</div>
        <div class="info-text">
            @user.Permissions.ToString()
        </div>
    </div>
</div>

<div class="pictochat-window">
    <div class="pictochat-message pictochat-enter-highlight">Now joining...</div>
    <div class="pictochat-message">
        <header class="ds-darkpurple-50">extraes</header>
        <span>
            hey welcome in to your dashboard! feel free to admire all the css work that I don't have to redo because I
            already did it once! it's a wonderful sight, isn't it?
        </span>
    </div>

    <div class="pictochat-status pictochat-exit-highlight">
        <span>extraes left</span>
    </div>


    @if (user.Permissions.HasFlag(Permissions.ManageUsers))
    {
        Write(await Html.RenderComponentAsync<UserManagement>(RenderMode.Static, new
        {
            User = user,
            AfTokens = tokens
        }));
    }
    
    @if (user.Permissions.HasFlag(Permissions.ListFiles))
    {
        Write(await Html.RenderComponentAsync<FileList>(RenderMode.Static, new
        {
            User = user,
            AfTokens = tokens
        }));
    }

</div>

<div style="flex: 1"></div>

<footer class="bar-lg ds-darkpurple-50">
    <footer>dashboard bottom text</footer>
</footer>

<script>
    let inputFields = $("input");
    for (let i = 0; i < inputFields.length; i++) {
        let field = inputFields[i];
        if (field.getAttribute("type") !== "text")
            continue;

        let onEnter = field.getAttribute("onenter");
        if (!onEnter)
            continue;

        field.addEventListener("keydown", e => {
            if (e.key === "Enter")
                eval(onEnter);
        });
    }
</script>

</body>
</html>