@using Microsoft.AspNetCore.Antiforgery
@using SuperCoolWebServer.Models

@code {
    [Parameter] public required SuperCoolUser User { get; init; }
    [Parameter] public required AntiforgeryTokenSet AfTokens { get; init; }
}

<script type="module">
    import { Links } from "../Views/Links.razor.js";

    Links.extraHeaders["@AfTokens.HeaderName"] = "@AfTokens.RequestToken";
    window.Links = Links;
</script>
<div class="pictochat-message">
    <header class="ds-blue-50">Links</header>
    <div style="display: grid;">
        <details style="justify-self: center;">
            <summary class="ds-blue-50">Create shortened link</summary>
            <div class="ds-repeating">

                <!--suppress JSDeprecatedSymbols -->
                <form onsubmit="event.preventDefault(); Links.setLink();">
                    <label>
                        <span class="ds-div">Link name (what you want to call it)</span>
                        <div class="input-wrapper">
                            <div class="input-before"></div>
                            <input id="set-link-name" type="text"/>
                            <div class="input-after"></div>
                        </div>
                    </label>
                    
                    <label>
                        <span class="ds-div">Link target (where you want it to go)</span>
                        <div class="input-wrapper">
                            <div class="input-before"></div>
                            <input id="set-link-target" type="text"/>
                            <div class="input-after"></div>
                        </div>
                    </label>
                    
                    <button id="set-link-btn" type="submit">Set redirect</button>
                </form>

                <div class="alert" style="display:none;">
                    <span id="set-link-output"></span>
                </div>
            </div>
        </details>


    </div>
</div>

