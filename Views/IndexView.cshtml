@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Identity
@using SuperCoolWebServer.Models
@using SuperCoolWebServer.Views
@using SuperCoolWebServer.Views.Components.Auth

@{
    var antiforgery = ViewContext.HttpContext.RequestServices.GetRequiredService<IAntiforgery>();
    var tokens = antiforgery.GetAndStoreTokens(Context);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <title>top text</title>
    @* Disable DarkReader because otherwise it looks like shit *@
    <meta name="darkreader-lock">
    
    <!--suppress JSUnresolvedLibraryURL -->
    <link rel="stylesheet" href="https://unpkg.com/@@spiritov/ds.css"/>
    <link href="/frontend/styles/main.css" rel="stylesheet">
    
    <link href="https://unpkg.com/uppy@5.2.4/dist/uppy.min.css" rel="stylesheet">
    <script src="https://unpkg.com/uppy@5.2.4/dist/uppy.min.js"></script>
    <script src="https://unpkg.com/jquery@4.0.0/dist/jquery.min.js"></script>
</head>

<body class="ds-grid">

<div class="pictochat-window">
    <div class="pictochat-message pictochat-enter-highlight">Now joining...</div>
    <div class="pictochat-message">
        <header class="ds-darkpurple-50">extraes</header>
        <span>
            welcome to my website! I'm more of a backend guy <sup>pause</sup>, so uh, hopefully judge me by my other projects?
        </span>
    </div>
    
    <div class="pictochat-message">
        <header class="ds-darkpurple-50">extraes</header>
        <span>
            I (mostly) made this with my own two human hands using the lovely
            <a href="https://github.com/spiritov/ds.css">ds.css</a> as the style framework :3
            It's still a WIP, but thanks for checking it out!
        </span>
    </div>
    
    <div class="pictochat-message">
        <header class="ds-darkpurple-50">extraes</header>
        <span>
            Anyways, thanks for checking out what I've got here! 
        </span>
    </div>
    
    <div class="pictochat-status pictochat-exit-highlight">
        <span>extraes left</span>
    </div>
</div>

<details>
    <summary>If you're here to upload something :o</summary>
    <div class="ds-repeating">
        @{
            var userManager = Context.RequestServices.GetRequiredService<UserManager<SuperCoolUser>>();
            var user = await userManager.GetUserAsync(Context.User);
            if (user is null)
            {
                Write(await Html.RenderComponentAsync<LoginCompoment>(RenderMode.Static, new
                {
                    Tokens = tokens
                }));
            }
            else if (user.Permissions.HasFlag(Permissions.UploadFiles))
            {
                <div>
                    <span>Welcome back @user.UserName  :3</span>
                    
                    
                    @{
                        Write(await Html.RenderComponentAsync<LogoutButton>(RenderMode.Static, new
                        {
                            Tokens = tokens,
                        }));   
                    }
                </div>
            
                <text><!-- modified chatgpt code LOL -->
                    <!-- Uppy Dashboard --></text>
                <div class="uploader" id="drag-drop-area"></div>

                @:<!-- Initialize Uppy -->
                <script>
            document.addEventListener('DOMContentLoaded', function () {
                const uppy = new Uppy.Uppy({
                    restrictions: {
                        // maxNumberOfFiles: 5,  // Limit number of files
                        // allowedFileTypes: ['image/*', 'video/*']  // Allow specific file types
                    },
                    autoProceed: false  // Automatically start upload
                })
                    .use(Uppy.Dashboard, {
                        inline: true,
                        target: '#drag-drop-area',
                        showProgressDetails: true,
                        height: 350 // this gets unset in the custom CSS. not setting it at all breaks things. 
                    })
                    .use(Uppy.Tus, {
                        endpoint: '/files', // Endpoint for file upload
                        chunkSize: 1024 * 1024 * 25 // 25mb to skate under cf req limits
                    });
        
                uppy.on('complete', (result) => {
                    console.log('Upload complete! We’ve uploaded these files:', result.successful);
                });
            });
        </script>
            }
        }
    </div>
</details>

<div style="flex: 1"></div>

<footer class="bar-lg ds-darkpurple-50">
    <footer>bottom text</footer>
</footer>

<script>
    
    
</script>
</body>
</html>